{
  "name": "koala",
  "version": "0.0.0",
  "description": "Landing page do ecossistema Koala — índice de koala-ui, koala-nest e koala-utils",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "bun run build:prod",
    "build:prod": "node generate-icons.js && ng build --configuration production && node scripts/post-build.mjs",
    "prestart": "node generate-icons.js",
    "preview": "bunx serve dist/koala/browser -p 4321"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.3.6",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.2.15",
    "daisyui": "^5.5.23",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.2"
  }
}
